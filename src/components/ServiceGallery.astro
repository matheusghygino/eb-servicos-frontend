---
import { Image } from 'astro:assets';
import serviceImageOne from '../assets/WhatsApp Image 2026-05-31 at 12.06.42.jpeg';
import serviceImageTwo from '../assets/WhatsApp Image 2026-05-31 at 12.06.43.jpeg';
import serviceImageThree from '../assets/WhatsApp Image 2026-06-20 at 10.12.48.jpeg';

const images = [
  {
    src: serviceImageOne,
    alt: 'Serviço de limpeza realizado pela EB Serviços em ambiente interno',
    title: 'Cuidado nos detalhes',
    description: 'Execução organizada para deixar cada área pronta para uso.',
  },
  {
    src: serviceImageTwo,
    alt: 'Resultado de limpeza profissional feita pela EB Serviços',
    title: 'Ambientes renovados',
    description: 'Limpeza com foco em aparência, higiene e sensação de frescor.',
  },
  {
    src: serviceImageThree,
    alt: 'Trabalho de limpeza da EB Serviços em Brasília DF',
    title: 'Atendimento sob demanda',
    description: 'Soluções para residências, empresas, eventos e pós-construção.',
  },
];
---

<section class="section-padding relative overflow-hidden bg-background">
  <div class="absolute inset-0 -z-10 bg-[radial-gradient(circle_at_10%_15%,rgba(85,199,232,0.18),transparent_26%),radial-gradient(circle_at_90%_30%,rgba(167,216,59,0.16),transparent_24%)]"></div>
  <div class="container-page">
    <div class="grid gap-8 lg:grid-cols-[0.82fr_1.18fr] lg:items-end">
      <div>
        <span class="eyebrow">Trabalhos realizados</span>
        <h2 class="mt-5 text-4xl font-black tracking-[-0.04em] text-text sm:text-5xl">Veja a EB Serviços em ação</h2>
      </div>
      <p class="text-lg leading-8 text-muted">
        Fotos reais dos serviços ajudam a mostrar o cuidado, a organização e o padrão visual que a EB Serviços busca entregar em cada atendimento.
      </p>
    </div>

    <div class="mt-12 grid gap-5 md:grid-cols-3">
      {images.map((image, index) => (
        <article class={`card-hover group overflow-hidden rounded-[32px] border border-border bg-white shadow-soft ${index === 1 ? 'md:mt-10' : ''}`}>
          <div class="relative aspect-[3/4] overflow-hidden bg-accent/10">
            <Image
              src={image.src}
              alt={image.alt}
              widths={[360, 520, 720]}
              sizes="(min-width: 768px) 33vw, 100vw"
              class="h-full w-full object-cover transition duration-500 group-hover:scale-105"
              loading={index === 0 ? 'eager' : 'lazy'}
            />
            <div class="absolute inset-x-0 bottom-0 h-32 bg-gradient-to-t from-primary-dark/72 to-transparent"></div>
            <span class="absolute left-5 top-5 rounded-full bg-white/90 px-4 py-2 text-xs font-black uppercase tracking-[0.14em] text-primary shadow-soft backdrop-blur">Serviço EB</span>
          </div>
          <div class="p-6">
            <h3 class="text-2xl font-black tracking-[-0.03em] text-text">{image.title}</h3>
            <p class="mt-3 leading-7 text-muted">{image.description}</p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
