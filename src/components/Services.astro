---
const services = [
  { icon: '🏠', title: 'Limpeza residencial', description: 'Cuidado completo para casas e apartamentos, com atenção aos detalhes do dia a dia.' },
  { icon: '🏢', title: 'Limpeza comercial', description: 'Ambientes corporativos organizados, limpos e preparados para receber clientes e equipes.' },
  { icon: '✨', title: 'Limpeza profunda', description: 'Higienização mais detalhada para recuperar o frescor e a sensação de ambiente novo.' },
  { icon: '🧱', title: 'Limpeza pós-construção', description: 'Remoção de resíduos e poeira fina após obras, reformas e entregas de imóveis.' },
  { icon: '🎪', title: 'Limpeza de eventos', description: 'Suporte de limpeza antes, durante ou depois de eventos sociais e corporativos.' },
  { icon: '🧹', title: 'Serviços gerais de limpeza', description: 'Soluções sob demanda e recorrentes para diferentes necessidades de limpeza.' },
];
---

<section id="servicos" class="section-padding bg-white">
  <div class="container-page">
    <div class="mx-auto max-w-3xl text-center">
      <span class="eyebrow mx-auto">Serviços</span>
      <h2 class="mt-5 text-4xl font-black tracking-[-0.04em] text-text sm:text-5xl">Soluções de limpeza para cada necessidade</h2>
      <p class="mt-5 text-lg leading-8 text-muted">Da rotina residencial à limpeza pós-obra, a EB Serviços entrega praticidade, cuidado e qualidade em Brasília - DF.</p>
    </div>

    <div class="mt-14 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
      {services.map((service) => (
        <article class="card-hover group rounded-[var(--radius-lg)] border border-border bg-surface p-7 shadow-soft">
          <div class="grid size-14 place-items-center rounded-2xl bg-accent/14 text-3xl transition group-hover:bg-primary group-hover:text-white">{service.icon}</div>
          <h3 class="mt-7 text-2xl font-black tracking-[-0.025em] text-text">{service.title}</h3>
          <p class="mt-3 leading-7 text-muted">{service.description}</p>
          <a href="#orcamento" class="mt-6 inline-flex font-extrabold text-primary transition hover:text-secondary-dark">Pedir orçamento →</a>
        </article>
      ))}
    </div>
  </div>
</section>
