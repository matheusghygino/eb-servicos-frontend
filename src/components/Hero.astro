---
const highlights = ['Limpeza recorrente', 'Pós-construção', 'Eventos', 'Sob demanda'];
---

<section id="inicio" class="relative isolate min-h-screen overflow-hidden pt-32 lg:pt-40">
  <div class="absolute inset-0 -z-10 bg-[radial-gradient(circle_at_15%_20%,rgba(85,199,232,0.22),transparent_30%),radial-gradient(circle_at_85%_15%,rgba(167,216,59,0.22),transparent_26%),linear-gradient(180deg,#F7FBFF_0%,#FFFFFF_72%,#F7FBFF_100%)]"></div>
  <div class="absolute left-[8%] top-32 -z-10 size-44 rounded-full bg-accent/20 blur-3xl"></div>
  <div class="absolute bottom-24 right-[10%] -z-10 size-64 rounded-full bg-secondary/15 blur-3xl"></div>

  <div class="container-page grid min-h-[calc(100vh-120px)] items-center gap-12 pb-20 lg:grid-cols-[1.04fr_0.96fr]">
    <div class="max-w-3xl">
      <span class="eyebrow">Limpeza profissional em Brasília</span>
      <h1 class="mt-6 text-5xl font-black leading-[0.98] tracking-[-0.055em] text-text sm:text-6xl lg:text-7xl">
        Limpeza profissional em Brasília para casas, empresas e eventos
      </h1>
      <p class="mt-6 max-w-2xl text-lg leading-8 text-muted sm:text-xl">
        A EB Serviços oferece soluções completas de limpeza com agilidade, cuidado e qualidade para deixar seu ambiente impecável.
      </p>
      <div class="mt-9 flex flex-col gap-4 sm:flex-row">
        <a href="#orcamento" class="btn-primary">Solicitar orçamento</a>
        <a href="#servicos" class="btn-ghost">Ver serviços</a>
      </div>
      <div class="mt-10 grid gap-3 sm:grid-cols-2 lg:max-w-xl">
        {highlights.map((item) => (
          <div class="flex items-center gap-3 rounded-2xl border border-border bg-white/78 p-3 shadow-soft backdrop-blur">
            <span class="grid size-9 place-items-center rounded-xl bg-accent/16 text-primary">✦</span>
            <span class="font-bold text-text">{item}</span>
          </div>
        ))}
      </div>
    </div>

    <div class="relative mx-auto w-full max-w-lg lg:max-w-none">
      <div class="absolute -left-8 top-16 z-10 hidden rounded-3xl border border-border bg-white/88 p-4 shadow-soft backdrop-blur sm:block">
        <span class="block text-3xl font-black text-primary">24h</span>
        <span class="text-sm font-bold text-muted">Retorno rápido</span>
      </div>
      <div class="absolute -right-3 bottom-16 z-10 rounded-3xl border border-border bg-white/90 p-4 shadow-soft backdrop-blur sm:-right-8">
        <span class="block text-3xl font-black text-secondary">DF</span>
        <span class="text-sm font-bold text-muted">Atendimento local</span>
      </div>

      <div class="relative overflow-hidden rounded-[42px] border border-white bg-white p-5 shadow-[0_32px_90px_rgba(15,47,74,0.14)]">
        <div class="rounded-[32px] bg-gradient-to-br from-primary via-primary-dark to-accent p-7 text-white">
          <div class="flex items-center justify-between">
            <span class="rounded-full bg-white/16 px-4 py-2 text-sm font-bold backdrop-blur">Ambiente impecável</span>
            <span class="grid size-12 place-items-center rounded-2xl bg-white/18 text-2xl">✨</span>
          </div>
          <div class="mt-16 grid gap-4">
            <div class="h-28 rounded-[28px] bg-white/16 p-5 backdrop-blur">
              <div class="mb-4 h-3 w-32 rounded-full bg-white/58"></div>
              <div class="h-3 w-full rounded-full bg-white/24"></div>
              <div class="mt-3 h-3 w-2/3 rounded-full bg-white/24"></div>
            </div>
            <div class="grid grid-cols-2 gap-4">
              <div class="rounded-[24px] bg-white p-5 text-text">
                <span class="mb-6 grid size-11 place-items-center rounded-2xl bg-accent/20 text-primary">🫧</span>
                <strong class="block text-xl font-black">Cuidado</strong>
                <span class="text-sm font-semibold text-muted">Detalhes importam</span>
              </div>
              <div class="rounded-[24px] bg-accent-green/95 p-5 text-primary-dark">
                <span class="mb-6 grid size-11 place-items-center rounded-2xl bg-white/40">🧼</span>
                <strong class="block text-xl font-black">Agilidade</strong>
                <span class="text-sm font-semibold">Equipe eficiente</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
